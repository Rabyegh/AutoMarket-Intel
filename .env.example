# ── Pipeline ──────────────────────────────────────────────────────────────
PIPELINE_ENV=local
RUN_LOG_PATH=data/run_log.jsonl

# ── Data paths ────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw/used_cars
DUCKDB_PATH=data/warehouse.duckdb

# ── Validation bounds ─────────────────────────────────────────────────────
MIN_LISTING_YEAR=1970
MAX_LISTING_YEAR=2025
MIN_PRICE_GBP=100
MAX_PRICE_GBP=500000
MAX_MILEAGE_MILES=500000

# ── Simulation ────────────────────────────────────────────────────────────
SIMULATION_SEED=42

# ── AWS / S3 (required for upload-s3 and nightly_snowflake.yml) ───────────
# Leave blank for local-only (DuckDB) runs.
AWS_DEFAULT_REGION=eu-west-1
S3_RAW_BUCKET=your-automarket-raw-bucket
S3_RAW_PREFIX=raw/used_cars

# ── Snowflake (required for load-snowflake and dbt --target snowflake) ────
# Leave blank for local-only (DuckDB) runs.
# Database name must match AUTOMARKET_DB created in infra/snowflake/setup.sql.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=AUTOMARKET_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.pem
SNOWFLAKE_DATABASE=AUTOMARKET_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=AUTOMARKET_WH
SNOWFLAKE_ROLE=AUTOMARKET_ROLE

# Stage and table names (defaults match infra/snowflake/setup.sql)
SNOWFLAKE_STAGE_NAME=RAW.S3_STAGE_AUTOMARKET
SNOWFLAKE_RAW_TABLE=RAW.RAW_USED_CAR_LISTINGS
