# ── Pipeline ──────────────────────────────────────────────────────────────
PIPELINE_ENV=local
RUN_LOG_PATH=data/run_log.jsonl

# ── Data paths ────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw/used_cars
DUCKDB_PATH=data/warehouse.duckdb

# ── Validation bounds ─────────────────────────────────────────────────────
MIN_LISTING_YEAR=1970
MAX_LISTING_YEAR=2025
MIN_PRICE_GBP=100
MAX_PRICE_GBP=500000
MAX_MILEAGE_MILES=500000

# ── Simulation ────────────────────────────────────────────────────────────
SIMULATION_SEED=42

# ── Snowflake (P1 — leave blank for local-only runs) ──────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# ── AWS / S3 (P1 — future cloud target) ───────────────────────────────────
AWS_DEFAULT_REGION=
S3_RAW_BUCKET=
