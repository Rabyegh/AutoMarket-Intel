# ── Pipeline ──────────────────────────────────────────────
PIPELINE_ENV=local           # local | snowflake
RUN_LOG_PATH=data/run_log.json

# ── vPIC API ───────────────────────────────────────────────
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api
VPIC_BATCH_SIZE=50
VPIC_RATE_SLEEP_S=1.0        # seconds between chunks
VPIC_MAX_RETRIES=3

# ── DuckDB ─────────────────────────────────────────────────
DUCKDB_PATH=data/warehouse.duckdb

# ── Snowflake (P1 – leave blank for local-only runs) ───────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# ── AWS / S3 (P1) ──────────────────────────────────────────
AWS_DEFAULT_REGION=
S3_RAW_BUCKET=
