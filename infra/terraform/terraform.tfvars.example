# terraform.tfvars.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is in .gitignore — NEVER commit it with real values.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   terraform plan -var-file=terraform.tfvars
# ─────────────────────────────────────────────────────────────────────────────

aws_region     = "eu-west-1"
aws_account_id = "123456789012"    # replace with your 12-digit AWS account ID
s3_raw_bucket  = "my-automarket-raw"   # must be globally unique
environment    = "dev"
github_repo    = "Rabyegh/AutoMarket-Intel"

# Fill in AFTER creating the Snowflake storage integration:
#   snowsql -f infra/snowflake/setup.sql   (uncomment the storage integration block)
#   DESC INTEGRATION S3_INT_AUTOMARKET;
snowflake_iam_user_arn = "arn:aws:iam::PLACEHOLDER:user/snowflake"
snowflake_external_id  = "PLACEHOLDER_EXTERNAL_ID"
